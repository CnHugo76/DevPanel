{
  "id": "p_mlapi22222",
  "revision": 1,
  "createdAt": "2026-10-11T12:11:57.250Z",
  "updatedAt": "2026-10-11T13:11:57.250Z",
  "config": {
    "schemaVersion": 1,
    "name": "ml-api",
    "root": "/Users/demo/Project/ml-api",
    "env": {
      "PYTHONUNBUFFERED": "1"
    },
    "params": [
      {
        "key": "port",
        "label": "接口端口",
        "type": "number",
        "value": 8000,
        "min": 1024,
        "max": 65535,
        "description": "uvicorn 监听端口。app/config.py 的 CORS 白名单写死了 localhost:8000，改端口后浏览器里的调试页会跨域失败，需要同步改那里。",
        "setBy": "agent",
        "valueUpdatedAt": "2026-10-11T12:12:57.250Z",
        "describedBy": "agent",
        "usedBy": [
          {
            "serviceId": "api",
            "where": "command",
            "index": 5
          }
        ]
      },
      {
        "key": "reload",
        "label": "自动重载",
        "type": "boolean",
        "value": true,
        "description": "开启后 uvicorn 监视 app/ 下的 .py 文件，保存即重启 worker。每次重启要重新加载 412 MB 的模型（约 6 秒），频繁保存时可以关掉。通过 UVICORN_RELOAD 环境变量传给 uvicorn。",
        "setBy": "agent",
        "valueUpdatedAt": "2026-10-11T12:12:57.250Z",
        "describedBy": "agent",
        "usedBy": [
          {
            "serviceId": "api",
            "where": "env",
            "envKey": "UVICORN_RELOAD"
          }
        ]
      },
      {
        "key": "hfToken",
        "label": "Hugging Face 令牌",
        "type": "string",
        "secret": true,
        "description": "app/model.py 首次启动时用它从 Hugging Face Hub 下载 tokenizer。下载后缓存在 ~/.cache/huggingface，之后留空也能启动。",
        "setBy": "user",
        "valueUpdatedAt": "2026-10-11T12:52:57.250Z",
        "describedBy": "agent",
        "usedBy": [
          {
            "serviceId": "api",
            "where": "env",
            "envKey": "HF_TOKEN"
          }
        ]
      }
    ],
    "services": [
      {
        "id": "api",
        "name": "ml-api",
        "cwd": ".",
        "command": [
          "uv",
          "run",
          "uvicorn",
          "app.main:app",
          "--port",
          "${port}"
        ],
        "env": {
          "UVICORN_RELOAD": "${reload}",
          "HF_TOKEN": "${hfToken}"
        }
      }
    ]
  }
}
