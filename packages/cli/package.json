{
  "name": "@devpanel/cli",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "bin": {
    "devpanel": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc -p .",
